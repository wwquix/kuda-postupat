{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/bseu-admission-subjects-2026-1.0.json",
  "title": "BSEU 2026 admission subjects audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "university_code",
    "admission_year",
    "checked_at",
    "source_policy",
    "sources",
    "requirement_definitions",
    "programs",
    "summary",
    "review_items"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "university_code": { "const": "bseu" },
    "admission_year": { "const": 2026 },
    "checked_at": { "type": "string", "format": "date-time" },
    "source_policy": { "$ref": "#/$defs/sourcePolicy" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "requirement_definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirementDefinition" }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/program" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "review_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewItem" }
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_only", "hierarchy", "allowed_domains", "local_scope_source", "note"],
      "properties": {
        "official_only": { "const": true },
        "hierarchy": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        },
        "local_scope_source": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "title",
        "publisher",
        "publication_or_admission_year",
        "source_type",
        "checked_at",
        "relevant_reference",
        "evidence_note",
        "content_sha256"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://bseu\\.by/" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "const": "Белорусский государственный экономический университет" },
        "publication_or_admission_year": { "const": 2026 },
        "source_type": { "enum": ["html", "pdf", "official_regulation"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "relevant_reference": { "type": "string", "minLength": 1 },
        "evidence_note": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "allowedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_key", "official_label_ru", "official_label_be"],
      "properties": {
        "subject_key": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "official_label_ru": { "type": "string", "minLength": 1 },
        "official_label_be": { "$ref": "#/$defs/nullableString" }
      }
    },
    "subjectGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_key",
        "position",
        "choose_count",
        "allowed_subjects",
        "assessment_form",
        "note"
      ],
      "properties": {
        "group_key": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "position": { "type": "integer", "minimum": 1 },
        "choose_count": { "type": "integer", "minimum": 1 },
        "allowed_subjects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/allowedSubject" }
        },
        "assessment_form": { "enum": ["ce_or_ct", "internal_written", "internal_oral"] },
        "note": { "$ref": "#/$defs/nullableString" }
      }
    },
    "requirementDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "label", "subject_groups", "source_ids"],
      "properties": {
        "definition_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "subject_groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subjectGroup" }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirementSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_set_id",
        "admission_year",
        "education_basis",
        "study_form",
        "track",
        "admission_pathway",
        "applicability",
        "requirement_definition_id",
        "source_ids"
      ],
      "properties": {
        "requirement_set_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "admission_year": { "const": 2026 },
        "education_basis": {
          "enum": ["full_track_eligible_basis", "corresponding_secondary_specialized_education"]
        },
        "study_form": { "enum": ["full_time", "part_time"] },
        "track": { "enum": ["full", "shortened"] },
        "admission_pathway": { "enum": ["general_competition", "targeted_training"] },
        "applicability": { "type": "string", "minLength": 1 },
        "requirement_definition_id": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_identity",
        "source_specialty_id",
        "slug",
        "existing_code",
        "official_admission_code",
        "imported_program_name",
        "status",
        "requirement_sets",
        "source_ids",
        "audit_note",
        "review_reason"
      ],
      "properties": {
        "program_identity": { "type": "string", "pattern": "^bseu\\|(?:code|normalized-name)\\|.+$" },
        "source_specialty_id": { "type": "string", "pattern": "^[0-9]+$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "existing_code": { "$ref": "#/$defs/nullableString" },
        "official_admission_code": { "type": "string", "pattern": "^[0-9]-[0-9]{2}-[0-9]{4}-[0-9]{2}$" },
        "imported_program_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["confirmed", "needs_review", "unavailable"] },
        "requirement_sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirementSet" }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "audit_note": { "type": "string", "minLength": 1 },
        "review_reason": { "$ref": "#/$defs/nullableString" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_programs",
        "confirmed",
        "needs_review",
        "unavailable",
        "requirement_sets",
        "requirement_definitions",
        "official_sources"
      ],
      "properties": {
        "target_programs": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "requirement_sets": { "type": "integer", "minimum": 0 },
        "requirement_definitions": { "type": "integer", "minimum": 0 },
        "official_sources": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_item_id", "program_identity", "reason", "source_ids"],
      "properties": {
        "review_item_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "program_identity": { "$ref": "#/$defs/nullableString" },
        "reason": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
