{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/university-import-export-1.0.json",
  "title": "Verified university catalog import and export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "university",
    "categories",
    "sources",
    "programs",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "university": { "$ref": "#/$defs/university" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/category" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "programs": {
      "type": "array",
      "items": { "$ref": "#/$defs/program" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "nullableUri": {
      "oneOf": [
        { "type": "string", "format": "uri", "pattern": "^https?://" },
        { "type": "null" }
      ]
    },
    "nullableDateTime": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "university": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "slug",
        "short_name",
        "full_name",
        "institution_kind",
        "ownership_type",
        "city",
        "region",
        "official_site_url",
        "admissions_url",
        "monitoring_status",
        "active",
        "source_url",
        "source_checked_at",
        "data_verified_at"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "short_name": { "type": "string", "minLength": 1 },
        "full_name": { "type": "string", "minLength": 1 },
        "institution_kind": {
          "enum": ["university", "academy", "institute", "conservatory", "military_academy", "other"]
        },
        "ownership_type": { "enum": ["state", "private", "mixed", "unknown"] },
        "city": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "official_site_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "admissions_url": { "$ref": "#/$defs/nullableUri" },
        "monitoring_status": {
          "enum": ["online", "partial", "periodic", "reference_only", "unsupported", "broken", "needs_review"]
        },
        "active": { "type": "boolean" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_checked_at": { "type": "string", "format": "date-time" },
        "data_verified_at": { "$ref": "#/$defs/nullableDateTime" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label_ru"],
      "properties": {
        "code": {
          "enum": [
            "it",
            "technical",
            "economic",
            "medical",
            "pedagogical",
            "agricultural",
            "arts",
            "sports",
            "military",
            "humanities",
            "law",
            "transport",
            "emergency_services",
            "general",
            "private",
            "other"
          ]
        },
        "label_ru": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_url", "source_checked_at"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "slug",
        "name",
        "qualification",
        "faculty_name",
        "official_url",
        "source_checked_at",
        "offerings"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "code": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "qualification": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "faculty_name": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "official_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_checked_at": { "type": "string", "format": "date-time" },
        "offerings": {
          "type": "array",
          "items": { "$ref": "#/$defs/offering" }
        }
      }
    },
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "admission_year",
        "study_form",
        "funding_type",
        "places",
        "application_deadline",
        "monitoring_supported",
        "monitoring_status",
        "official_url",
        "source_url",
        "source_checked_at"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "admission_year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "study_form": { "enum": ["full_time", "part_time", "distance", "evening", "other"] },
        "funding_type": { "enum": ["budget", "paid", "targeted", "separate_competition", "other"] },
        "places": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "application_deadline": { "$ref": "#/$defs/nullableDateTime" },
        "monitoring_supported": { "type": "boolean" },
        "monitoring_status": {
          "enum": ["online", "partial", "periodic", "reference_only", "unsupported", "broken", "needs_review"]
        },
        "official_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "source_checked_at", "data_verified_at"],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_checked_at": { "type": "string", "format": "date-time" },
        "data_verified_at": { "$ref": "#/$defs/nullableDateTime" }
      }
    }
  }
}
